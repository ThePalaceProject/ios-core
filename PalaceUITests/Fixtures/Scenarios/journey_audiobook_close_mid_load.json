    { "pathPattern": "^https://palace-fixtures\\.test/library/works/still-water/borrow$", "setsFlag": "borrowed", "fixtureName": "borrow_entry_audiobook.xml", "statusCode": 201, "contentType": "application/atom+xml;type=entry;profile=opds-catalog" },
