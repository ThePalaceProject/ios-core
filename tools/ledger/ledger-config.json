{
  "architectureStyle": "layered",
  "componentRoots": [
    "Palace",
    "Palace/Accounts",
    "Palace/AppInfrastructure",
    "Palace/AppRating",
    "Palace/Audiobooks",
    "Palace/Book",
    "Palace/BuildSupport",
    "Palace/CarPlay",
    "Palace/Catalog",
    "Palace/CatalogDomain",
    "Palace/CatalogUI",
    "Palace/ErrorHandling",
    "Palace/FeatureFlags",
    "Palace/Holds",
    "Palace/Keychain",
    "Palace/Logging",
    "Palace/Migrations",
    "Palace/MyBooks",
    "Palace/Network",
    "Palace/Notifications",
    "Palace/OPDS",
    "Palace/OPDS2",
    "Palace/PDF",
    "Palace/Platform",
    "Palace/Reader2",
    "Palace/ReaderStreaming",
    "Palace/Settings",
    "Palace/SignInLogic",
    "Palace/Stats",
    "Palace/Support",
    "Palace/Utilities",
    "Palace/Views"
  ],
  "excludePaths": [
    "*.build",
    "*.generated.swift",
    "*.pb.swift",
    ".build",
    "Build",
    "Carthage",
    "DerivedData",
    "External",
    "Pods",
    "Rome",
    "SourcePackages",
    "ThirdParty",
    "Vendor",
    "adobe-*",
    "build",
    "fastlane",
    "mobile-*",
    "node_modules",
    "readium-*",
    "scripts",
    "third_party",
    "vendor"
  ],
  "includeCodeSnippetsInAsk": false,
  "inferenceAggressiveness": "conservative",
  "layerRules": {
    "allowedEdges": [
      {
        "from": "Application",
        "to": "Presentation"
      },
      {
        "from": "Application",
        "to": "Domain"
      },
      {
        "from": "Presentation",
        "to": "Domain"
      },
      {
        "from": "Domain",
        "to": "Infrastructure"
      }
    ],
    "layers": [
      "Infrastructure",
      "Domain",
      "Presentation",
      "Application",
      "Tests"
    ]
  },
  "firstPartyRoots": ["Palace", "PalaceTests", "PalaceUIKit"],
  "submoduleExclusions": [
    "ios-tenprintcover",
    "adept-ios",
    "ios-audiobook-overdrive",
    "OverdriveProcessorDriver"
  ],
  "projectName": "Palace",
  "questionBudgetInit": 7,
  "questionBudgetUpdate": 2,
  "topFlows": [
    "auth",
    "borrow",
    "download",
    "holds",
    "read",
    "return",
    "search",
    "sync"
  ],
  "verificationCommands": [
    "xcodebuild build",
    "xcodebuild test",
    "fastlane test",
    "make test"
  ],
  "version": 1,
  "layerOverrides": {
    "Palace": "Application",
    "Palace-noDRM": "Application",
    "PalaceUIKit": "Presentation",
    "PalaceTests": "Tests",
    "ios-audiobooktoolkit": "Presentation",
    "adept-ios": "Infrastructure",
    "ios-tenprintcover": "Infrastructure"
  },
  "knownLayerViolations": [
    {
      "from": "ios-audiobooktoolkit",
      "to": "PalaceUIKit",
      "reason": "Toolkit provides both core playback (Infrastructure) and default UI (Presentation). UI components import PalaceUIKit for shared styles."
    }
  ],
  "knownFalsePositiveEdges": [
    {
      "from": "PalaceTriageBot",
      "aka": "TriageBotUI",
      "to": "Palace",
      "confidence": "name-inferred",
      "reason": "SwiftPM structurally forbids a package (PalaceTriageBot / its TriageBotUI target) from importing the app target (Palace). This edge is a name-based inference artifact, not a real import — the compiler cannot produce it. The trend gate must DISCOUNT it so the cycle count is not inflated by an impossible edge. See docs/architecture/god-class-decomposition-plan.md §3b cycle 9 (Wave 0 ledger hygiene)."
    }
  ]
}
