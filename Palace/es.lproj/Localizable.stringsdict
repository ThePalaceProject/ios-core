			<key>other</key>
			<string>%d d</string>
		</dict>
	</dict>
	<key>hold_status_copies_in_use</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Ocupa el %1$@ puesto en la lista de espera. %2$#@copies@</string>
