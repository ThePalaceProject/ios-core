"When enabled, books and audiobooks will only download over Wi-Fi. Downloads will be blocked on cellular data." = "Lorsque cette option est activée, les livres et les livres audio sont téléchargés uniquement en Wi-Fi. Les téléchargements sont bloqués sur les données cellulaires.";

"When on, a support ticket includes your app and device version, network state, and a short tail of recent activity so support can solve problems faster. Turn it off to send only your app and device version." = "Lorsque cette option est activée, une demande d’assistance inclut la version de votre application et de votre appareil, l’état du réseau et un bref extrait de votre activité récente afin que l’assistance puisse résoudre les problèmes plus rapidement. Désactivez-la pour n’envoyer que la version de votre application et de votre appareil.";

"When you reserve a book from the catalog, it will show up here. Look here from time to time to see if your book is available to download." = "Lorsque vous réservez un livre du catalogue, il apparaîtra ici. Regardez ici de temps en temps pour voir si votre livre est disponible en téléchargement.";

/* VoiceOver custom action that announces the patron's current reading position without moving focus */
"Where am I?" = "Où en suis-je ?";

/* Alert title when download is blocked due to Wi-Fi only setting */
"Wi-Fi Required" = "Wi-Fi requis";

"Would you like to return it?" = "Souhaitez-vous le retourner ?";

/* Confirmation shown when choosing an inactive library's selection control. %@ is the library name. */
"Would you like to switch to %@?" = "Voulez-vous passer à %@ ?";

/* Affirmative answer in a confirmation prompt. */
"Yes" = "Oui";

/* Sentiment-gate button; a positive response that leads to the native App Store rating prompt. */
"Yes, I love it!" = "Oui, je l’adore !";

/* Confirms the stop-playback dialog: stops playback and dismisses the mini-player */
"Yes, Stop" = "Oui, arrêter";

/* User hold position without copies info. Format: 'You are 5th in line.' */
"You are %1$@ in line." = "Vous êtes en %1$@ position dans la file d’attente.";

/* User hold position and number of copies in use. Format: 'You are 5th in line. 3 copies in use.' */
"You are %1$@ in line. %2$d %3$@ in use." = "Vous êtes en %1$@ position dans la file d’attente. %2$d %3$@ en circulation.";

/* Alert message shown when the user attempts to download or reserve a book while offline */
"You don’t appear to be connected to the internet. Reconnect and try again." = "Aucune connexion à Internet ne semble active. Rétablissez la connexion et réessayez.";

"You have already checked out this loan. You may need to refresh your My Books list to download the title." = "Vous avez déjà vérifié ce prêt. Vous devrez peut-être actualiser votre liste Mes livres pour télécharger le titre.";

"You have disabled location services for this app." = "Vous avez désactivé les services de localisation pour cette application.";

"You must enable camera access for this application in order to sign up for a library card." = "Vous devez activer l'accès à l'appareil photo pour cette application afin de vous inscrire pour obtenir une carte de bibliothèque.";

"You need to login to access the collection." = "Vous devez vous connecter pour accéder à la collection.";

/* Title of the catalog offline state shown when the device has no internet connection */
"You're Offline" = "Vous êtes hors ligne";

"Your Audiobook Has Finished" = "Votre livre audio est terminé";

/* Alert title when a book's DRM license has expired */
"Your Loan Has Expired" = "Votre emprunt a expiré";

"Your authentication details have expired. Please sign in again." = "Vos informations d'authentification ont expiré. Veuillez vous reconnecter.";

"Your bookmarks and reading positions are in the process of being saved to the server. Would you like to stop that and continue logging out?" = "Vos signets et positions de lecture sont en cours d'enregistrement sur le serveur. Souhaitez-vous arrêter et poursuivre la déconnexion ?";

"Your report will be reviewed as soon as possible." = "Votre rapport sera examiné dès que possible.";

/* Message explaining that the user's session has expired */
"Your session has expired. Please sign in again to continue." = "Votre session a expiré. Veuillez vous reconnecter pour continuer.";

/* Title of the My Books empty state shown when the patron has no books */
"Your shelf is empty" = "Votre étagère est vide";

/* VoiceOver fragment '%@' is an author name — used in Continue Listening / Continue Reading card labels. */
"by %@" = "de %@";

"copies" = "exemplaires";

"copy" = "exemplaire";

"currently" = "actuellement";

/* VoiceOver fragment appended to a Continue Listening row card when the audiobook is actively playing. */
"currently playing" = "en cours de lecture";

"eCard" = "eCard";

"ePub" = "ePub";

/* Placeholder; final wording awaits design review per feedback_no_new_copy_without_design */
"opds.error.feed_invalid" = "Le catalogue de votre bibliothèque ne peut pas être chargé pour le moment — réessayez dans un instant.";

"returning" = "retour en cours";

"sec" = "s";
