"Would you like to return it?" = "Vuoi restituirlo?";

/* Confirmation shown when choosing an inactive library's selection control. %@ is the library name. */
"Would you like to switch to %@?" = "Vuole passare a %@?";

/* Affirmative answer in a confirmation prompt. */
"Yes" = "Sì";

/* Sentiment-gate button; a positive response that leads to the native App Store rating prompt. */
"Yes, I love it!" = "Sì, la adoro!";

/* Confirms the stop-playback dialog: stops playback and dismisses the mini-player */
"Yes, Stop" = "Sì, interrompi";

/* User hold position without copies info. Format: 'You are 5th in line.' */
"You are %1$@ in line." = "Lei è al %1$@ posto nella lista d’attesa.";

/* User hold position and number of copies in use. Format: 'You are 5th in line. 3 copies in use.' */
"You are %1$@ in line. %2$d %3$@ in use." = "Lei è al %1$@ posto nella lista d’attesa. %2$d %3$@ in uso.";

/* Alert message shown when the user attempts to download or reserve a book while offline */
"You don’t appear to be connected to the internet. Reconnect and try again." = "Non risulta alcuna connessione a Internet. Ristabilisca la connessione e riprovi.";

"You have already checked out this loan. You may need to refresh your My Books list to download the title." = "Hai già preso in prestito questo libro. Potrebbe essere necessario aggiornare l’elenco I miei libri per scaricare il titolo.";

"You have disabled location services for this app." = "Hai disabilitato i servizi di localizzazione per questa app.";

"You must enable camera access for this application in order to sign up for a library card." = "Per questa applicazione è necessario abilitare l’accesso alla fotocamera per registrarsi e ottenere una tessera della biblioteca.";

"You need to login to access the collection." = "Devi effettuare il login per accedere alla raccolta.";

/* Title of the catalog offline state shown when the device has no internet connection */
"You're Offline" = "Nessuna connessione";

"Your Audiobook Has Finished" = "Il tuo audiolibro è terminato";

/* Alert title when a book's DRM license has expired */
"Your Loan Has Expired" = "Il suo prestito è scaduto";

"Your authentication details have expired. Please sign in again." = "I tuoi dati di autenticazione sono scaduti. Accedi di nuovo.";

"Your bookmarks and reading positions are in the process of being saved to the server. Would you like to stop that and continue logging out?" = "I segnalibri e i punti di interruzione della lettura sono in fase di salvataggio sul server. Vuoi interrompere l’operazione e procedere alla disconnessione?";

"Your report will be reviewed as soon as possible." = "La tua segnalazione verrà esaminata il prima possibile.";

/* Message explaining that the user's session has expired */
"Your session has expired. Please sign in again to continue." = "La sua sessione è scaduta. Effettui di nuovo l’accesso per continuare.";

/* Title of the My Books empty state shown when the patron has no books */
"Your shelf is empty" = "Il suo scaffale è vuoto";

/* VoiceOver fragment '%@' is an author name — used in Continue Listening / Continue Reading card labels. */
"by %@" = "di %@";

"copies" = "copie";

"copy" = "copia";

"currently" = "attualmente";

/* VoiceOver fragment appended to a Continue Listening row card when the audiobook is actively playing. */
"currently playing" = "in riproduzione";

"eCard" = "eCard";

"ePub" = "ePub";

