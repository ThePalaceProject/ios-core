      "id": "KI-2026-004-wrong-library-palace-bookshelf",
      "category": "library",
      "status": "user_error",
      "symptom_keywords": [
        "wrong books",
        "wrong library",
        "not my books",
        "not my library",
        "where is my library",
        "where's my library",
