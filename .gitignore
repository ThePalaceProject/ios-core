# Swift Package Manager build artifacts. Apply at any depth so nested
# packages under Palace/Packages/<name>/ are covered without each one
# needing its own .gitignore. Without this, cross-branch builds (e.g.
# building feat/palace-triage-bot-ios-demo and then switching branches)
# leak empty package shells with .build/ + .swiftpm/ into git status.
**/.build/
**/.swiftpm/
.accesslint-cache/
accesslint-reports/
artifacts/
reports/
tools/*
!tools/palace-test-orchestrator/
**/ReaderClientCert.sig
**/APIKeys.swift
Carthage*
.build/
**/.build/
**/TPPSecrets.swift
**/GoogleService-Info.plist
fastlane/report.xml
fastlane/*_output
Palace.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
Palace.xcodeproj/xcshareddata/xcschemes/Palace.xcscheme
*.xcresult
.ledger/config.json
.ledger/index.sqlite
.ledger/last_update.json
.ledger/model.json
docs/ledger/CONTRACTS/CONTRACT_AudiobookBookmarkDelegate.md
docs/ledger/CONTRACTS/CONTRACT_AudiobookLifecycleListener.md
docs/ledger/CONTRACTS/CONTRACT_AudiobookManager.md
docs/ledger/CONTRACTS/CONTRACT_AudiobookNetworkService.md
docs/ledger/CONTRACTS/CONTRACT_AudiobookPlaybackTrackerDelegate.md
docs/ledger/CONTRACTS/CONTRACT_CatalogAPI.md
docs/ledger/CONTRACTS/CONTRACT_CatalogRepositoryProtocol.md
docs/ledger/CONTRACTS/CONTRACT_DataManager.md
docs/ledger/CONTRACTS/CONTRACT_DownloadTask.md
docs/ledger/CONTRACTS/CONTRACT_DRMDecryptor.md
docs/ledger/CONTRACTS/CONTRACT_ImageCacheType.md
docs/ledger/CONTRACTS/CONTRACT_LCPStreamingProvider.md
docs/ledger/CONTRACTS/CONTRACT_NetworkClient.md
docs/ledger/CONTRACTS/CONTRACT_Player.md
docs/ledger/CONTRACTS/CONTRACT_PositionCalculating.md
docs/ledger/CONTRACTS/CONTRACT_StreamingCapablePlayer.md
docs/ledger/CONTRACTS/CONTRACT_StreamingResourceProvider.md
docs/ledger/CONTRACTS/CONTRACT_TimeEntry.md
docs/ledger/CONTRACTS/CONTRACT_TPPPublicationSpeechSynthesizerDelegate.md
docs/ledger/CONTRACTS/CONTRACT_Track.md
docs/ledger/CONTRACTS/CONTRACT_TrackFactoryProtocol.md
docs/ledger/FLOWS/FLOW_audiobookplayback.md
docs/ledger/FLOWS/FLOW_checkout.md
docs/ledger/FLOWS/FLOW_login.md
docs/ledger/INDEX.md
docs/ledger/OPEN_QUESTIONS.md
docs/ledger/SYSTEM_MAP.md
docs/ledger/VERIFICATION.md
readium-sdk

# AccessLint reports and cache
accesslint-reports/
.accesslint-cache/

# Jira integration credentials (local only - never commit)
.jira-config

# Cursor IDE local rules
.cursor/
.claude/settings.local.json

# Environment files (local secrets - never commit)
.env
.env.local
.env*.local

# QAAtlas output (generated files)
qaatlas-output/
qaatlas-v2-report/

# Ledger artifacts (generated files - regenerate with `ledger update`)
artifacts/ledger/

# Ledger internal state (regenerated automatically)
.ledger/index.sqlite
.ledger/model.json
.ledger/last_update.json
.ledger/flows/flows-intent.yaml

# Ledger generated docs (regenerated with `ledger update`)
# Keep: INDEX.md, SYSTEM_MAP.md (contain MANUAL sections)
# Keep: FLOWS/*.md (human-authored flow documentation)
# Keep: FEEDBACK_*.md (human feedback)
docs/ledger/CONTRACTS/
docs/ledger/DELTAS/
docs/ledger/ANALYSIS.md
docs/ledger/OPEN_QUESTIONS.md
docs/ledger/VERIFICATION.md

# Tools binaries (downloaded, not committed)
tools/bin/

# Reports (generated during validation, can be large)
reports/

# Spec documents (generated by ledger spec build)
docs/spec/

# SpecterQA — keep journeys and evidence, ignore runtime artifacts
.specterqa/reports/
.specterqa/products/
.specterqa/*.log
!.specterqa/journeys/
!.specterqa/PR_TEST_EVIDENCE.md
!.specterqa/DOGFOOD_NOTES.md
scripts/sim-test/

# Backup pbxproj variants
*.pbxproj.swift-only
*.pbxproj.bak
ios-core-cm-monitor
scripts/__pycache__/

# palace-mutate report artifact (regenerated on every run)
palace-mutate-report.json
scripts/tests/__pycache__/
