#!/usr/bin/env bash
# commit-msg
#
# Purpose:
#   1. M1 message-dependent gates — contract-reconciliation and
#      intent-recorded validate claims in the commit message against the
#      staged diff. They run HERE (not in pre-commit) because this is the
#      first hook stage where git provides the real in-progress message
#      ($1); at pre-commit time COMMIT_EDITMSG still holds the PREVIOUS
#      commit's message, so reading it there validates stale claims.
#   2. For commits that touch ≥50 lines of production Swift/Obj-C code,
#      require the commit body to acknowledge what was deferred or
#      out-of-scope. This nudges authors to be honest about scope rather
#      than burying loose ends in a one-line subject. Outside contributors
#      and small commits pass through unchanged.
#
#   If the maintainer's local agent harness is installed
#   (~/harness/core/hooks/commit-msg-stanza.sh), exec to it for step 2 —
#   that version has richer behavior tied to ForgeOS changesets. The M1
#   gates run before the exec either way.
#
# Install:
#   git config core.hooksPath scripts/git-hooks
#   (run from the repo root; one-time)
#
# Argument:
#   $1 — path to the commit message file (provided by git).

set -euo pipefail

MSG_FILE="${1:-}"
if [[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]]; then
  exit 0
fi

# =============================================================================
# M1 Universal-Rigor Floor — message-dependent gates
# =============================================================================
# Same tri-state escalation as pre-commit's diff-only gates; the shared logic
# lives in m1-rigor-lib.sh. Skipped entirely when nothing is staged (e.g.
# `--allow-empty`, merge-conflict resolution flows with empty index diffs).

HOOK_DIR_M1="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT_M1="$(cd "$HOOK_DIR_M1/../.." && pwd)"

if [[ -n "$(git diff --cached --name-only --diff-filter=AM 2>/dev/null || true)" ]]; then
  M1_HOOK_NAME="commit-msg"
  # shellcheck source=scripts/git-hooks/m1-rigor-lib.sh
  source "$REPO_ROOT_M1/scripts/git-hooks/m1-rigor-lib.sh"
  m1_compute_mode

  M1_DIFF=$(mktemp -t m1-diff.XXXX)
  trap 'rm -f "$M1_DIFF"' EXIT
  git diff --cached > "$M1_DIFF" 2>/dev/null || true

  # Resolve a matching intent file if one exists. Match on first 2
  # dash-separated tokens of the commit subject — taken from the REAL
  # message file git handed us, not COMMIT_EDITMSG.
  M1_INTENT_FLAG=()
  M1_SUBJECT=$(grep -v '^#' "$MSG_FILE" | head -1 | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9 ]//g' | awk '{print $1"-"$2}')
  if [[ -n "$M1_SUBJECT" ]] && [[ -d "$REPO_ROOT_M1/.forgeos/intent" ]]; then
    M1_INTENT_MATCH=$(find "$REPO_ROOT_M1/.forgeos/intent" -maxdepth 1 -name "*${M1_SUBJECT}*.md" -type f 2>/dev/null | head -1)
    [[ -n "$M1_INTENT_MATCH" ]] && M1_INTENT_FLAG=(--intent "$M1_INTENT_MATCH")
  fi

  echo "commit-msg M1: prod-LOC added=$PROD_LOC_ADDED critical=$([[ -n "$STAGED_CRITICAL" ]] && echo yes || echo no) mode=$M1_MODE"

  M1_FAIL=0
  # check-contract-reconciliation.py needs a claim source (commit msg +
  # optional intent) — without one it silently passes (architect rev_f1c4ea3c
  # finding). check-intent-recorded.py needs `--commit-msg` to match the
  # subject against the intent file's `name:` field. The `[@]+` guard keeps
  # the empty-array expansion safe under `set -u` on macOS's bash 3.2.
  if ! run_m1_check "contract_reconciliation" "scripts/check-contract-reconciliation.py" --commit-msg "$MSG_FILE" ${M1_INTENT_FLAG[@]+"${M1_INTENT_FLAG[@]}"}; then
    M1_FAIL=$((M1_FAIL + 1))
  fi
  if ! run_m1_check "intent_recorded" "scripts/check-intent-recorded.py" --commit-msg "$MSG_FILE"; then
    M1_FAIL=$((M1_FAIL + 1))
  fi

  m1_enforce "$M1_FAIL"

  # Discipline nudges — ADVISORY only, never blocks (the script always exits 0;
  # the `|| true` is belt-and-suspenders). Surfaces retro-tracked habits at
  # commit time: a fix commit missing a root-cause line, or a fix/feat changing
  # source with no test. Runs after the M1 gates pass.
  if [[ -f "$REPO_ROOT_M1/scripts/check-discipline-nudge.py" ]]; then
    python3 "$REPO_ROOT_M1/scripts/check-discipline-nudge.py" --commit-msg "$MSG_FILE" --diff "$M1_DIFF" 2>&1 || true
  fi
fi

HARNESS_HOOK="$HOME/harness/core/hooks/commit-msg-stanza.sh"
if [[ -x "$HARNESS_HOOK" ]]; then
  exec "$HARNESS_HOOK" "$MSG_FILE"
fi

# --- Plain-bash fallback (no harness installed) --------------------------------

# Sum insertions+deletions across staged production sources.
# `git diff --cached --stat` last line looks like:
#   " 3 files changed, 42 insertions(+), 7 deletions(-)"
STATS=$(git diff --cached --stat -- 'Palace/**/*.swift' 'Palace/**/*.m' 2>/dev/null | tail -1 || true)
INS=$(echo "$STATS" | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+' || echo 0)
DEL=$(echo "$STATS" | grep -oE '[0-9]+ deletion'  | grep -oE '[0-9]+' || echo 0)
DELTA=$(( ${INS:-0} + ${DEL:-0} ))

THRESHOLD=50
if (( DELTA < THRESHOLD )); then
  exit 0
fi

# Strip git comment lines before checking for the stanza.
BODY=$(grep -v '^#' "$MSG_FILE" || true)
if echo "$BODY" | grep -qE '\*\*(Not done|Scope|Deferred):\*\*'; then
  exit 0
fi

cat >&2 <<EOF
ERROR: commit-msg hook

This commit changes ${DELTA} lines of production code (>= ${THRESHOLD} threshold)
but the commit body does not include a scope/deferral stanza.

Add ONE of the following to the commit body so reviewers know what was
intentionally left out:

  **Not done:**  <list anything you punted on>
  **Scope:**     <what this commit is and is not>
  **Deferred:**  <follow-up tickets or branches>

Re-edit your message and commit again. To bypass on a one-off, you can use
\`git commit --no-verify\` — but please don't make a habit of it.
EOF
exit 1
